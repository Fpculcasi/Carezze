rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /persons/{personId} {
      allow read: if isAuthenticated() &&
                     request.auth.uid in resource.data.members;
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.createdBy &&
                       request.resource.data.members[request.auth.uid] == 'OWNER';
      allow update: if isAuthenticated() &&
                       request.auth.uid in resource.data.members;
      allow delete: if isAuthenticated() &&
                       resource.data.members[request.auth.uid] == 'OWNER';

      match /therapies/{therapyId} {
        // Person members can create therapies; therapy members can read/update; therapy owners can delete
        allow create: if isAuthenticated() &&
                         request.auth.uid in
                           get(/databases/$(database)/documents/persons/$(personId)).data.members &&
                         request.resource.data.members[request.auth.uid] == 'OWNER';
        allow read: if isAuthenticated() &&
                       request.auth.uid in resource.data.memberIds;
        allow update: if isAuthenticated() &&
                         request.auth.uid in resource.data.members;
        allow delete: if isAuthenticated() &&
                         resource.data.members[request.auth.uid] == 'OWNER';

        match /medicationLogs/{logId} {
          allow read, write: if isAuthenticated() &&
                                request.auth.uid in
                                  get(/databases/$(database)/documents/persons/$(personId)/therapies/$(therapyId)).data.memberIds;
        }
      }
    }

    // Activity logs — TODO(M5): restrict to person members
    match /activityLogs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Invitations — TODO(M6): restrict creation to person owner
    match /invitations/{invitationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
