rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: caller owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection — each user can read/write their own document
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Persons — only owner or members can read/write
    function isPersonMember(personData) {
      return isAuthenticated() &&
             request.auth.uid in personData.members;
    }

    match /persons/{personId} {
      allow read: if isAuthenticated() &&
                     request.auth.uid in resource.data.members;
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.createdBy &&
                       request.resource.data.members[request.auth.uid] == 'OWNER';
      allow update: if isAuthenticated() &&
                       request.auth.uid in resource.data.members;
      allow delete: if isAuthenticated() &&
                       resource.data.members[request.auth.uid] == 'OWNER';
    }

    // Therapies
    match /therapies/{therapyId} {
      allow read, write: if isAuthenticated();  // TODO(M4): restrict to person members
    }

    // Medication logs
    match /medicationLogs/{logId} {
      allow read, write: if isAuthenticated();  // TODO(M4): restrict to therapy members
    }

    // Activity logs
    match /activityLogs/{logId} {
      allow read, write: if isAuthenticated();  // TODO(M5): restrict to person members
    }

    // Invitations
    match /invitations/{invitationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();  // TODO(M6): restrict creation to person owner
    }

    // Catch-all — deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
